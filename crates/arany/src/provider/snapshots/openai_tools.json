    {
      "description": "Apply a unique literal replacement to the real Workspace file, guarded by its current SHA-256. To append, replace a unique file ending with that ending plus new text.",
      "name": "arany_edit",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "expected_digest": {
            "description": "Exact lowercase 64-character SHA-256 from the file include or a successful Read. Never invent it.",
            "type": "string"
          },
          "new": {
            "description": "Replacement literal text. Combined old and new UTF-8 size must be at most 8192 bytes.",
            "type": "string"
          },
          "old": {
            "description": "Non-empty exact literal text occurring once in the current file. To append, select a unique ending and include that ending plus the appended text in new.",
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "expected_digest",
          "old",
          "new"
        ],
        "type": "object"
      },
      "strict": true,
      "type": "function"
    },
