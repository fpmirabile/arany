        "type": "object"
      },
      "strict": true,
      "type": "function"
    },
    {
      "description": "Show the Workspace repository's branch and its changed, unmerged and untracked paths under a path. Read-only; repository configuration, hooks and filters never run.",
      "name": "arany_git_status",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Workspace-relative path that limits the result; \".\" for the whole repository.",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "strict": true,
      "type": "function"
    },
    {
      "description": "Show changed-file line counts and a bounded unified patch: working tree vs index, staged index vs base or HEAD, working tree vs base, or base vs head. Read-only.",
      "name": "arany_git_diff",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "base": {
            "description": "null, or HEAD, a branch or tag name, or a 7-64 character hex commit name, with at most four ~N or ^N ancestry steps (N at most 9999). No ranges, ':' or '@{'. At most 128 bytes.",
            "type": [
              "string",
              "null"
            ]
          },
          "head": {
            "description": "null, or HEAD, a branch or tag name, or a 7-64 character hex commit name, with at most four ~N or ^N ancestry steps (N at most 9999). No ranges, ':' or '@{'. At most 128 bytes.",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "Workspace-relative path that limits the result; \".\" for the whole repository.",
            "type": "string"
          },
          "staged": {
            "description": "true compares the index with base, or HEAD when base is null; head must then be null. false compares the working tree with the index (no revisions), with base, or compares base with head.",
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "base",
          "head",
          "staged"
        ],
        "type": "object"
      },
      "strict": true,
      "type": "function"
    },
    {
      "description": "List up to max_count commits (hash, parents, author, Unix time, subject) from revision or HEAD that touch a path, newest first. Read-only.",
      "name": "arany_git_log",
