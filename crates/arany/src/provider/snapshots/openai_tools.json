    {
      "description": "Read a Workspace file and obtain its whole-file SHA-256. Page from next_offset when truncated. Read further pages yourself when needed.",
      "name": "arany_read",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "description": "Number of UTF-8 bytes to read: integer 1 through 65536 inclusive. Use 65536 for a normal page; never request the whole file with a larger limit.",
            "type": "integer"
          },
          "offset": {
            "description": "Zero-based byte offset, 0 through 4294967295. Start at 0; page using the returned next offset.",
            "type": "integer"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "offset",
          "limit"
        ],
        "type": "object"
      },
      "strict": true,
      "type": "function"
    },
    {
      "description": "Search literal UTF-8 content in a Workspace file or directory. Use Read or an include for edit SHA-256.",
      "name": "arany_search",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "query": {
            "type": "string"
