    "PlatformOs": {
      "enum": [
        "linux",
        "macos"
      ],
      "type": "string"
    },
    "Reason": {
      "enum": [
        "notInitialized",
        "alreadyInitialized",
        "messageTooLarge",
        "busy",
        "threadNotLoaded",
        "threadLimit",
        "turnNotActive",
        "serverShuttingDown",
        "invalidParams",
        "unsupportedPermissionMode",
        "runFull",
        "empty",
