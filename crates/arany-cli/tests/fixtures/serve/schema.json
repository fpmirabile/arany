              "type": "array"
            },
            "disposition": {
              "enum": [
                "succeeded",
                "denied",
                "failed",
                "conflict",
                "limit",
                "cancelled",
                "uncertain",
                null
              ]
            },
            "id": {
              "type": "string"
            },
            "output": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/ItemStatus"
            },
            "type": {
              "const": "fileChange",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "changes",
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "arguments": true,
            "disposition": {
              "enum": [
                "succeeded",
                "denied",
                "failed",
                "conflict",
                "limit",
                "cancelled",
                "uncertain",
                null
              ]
            },
            "id": {
              "type": "string"
            },
            "output": {
              "type": [
                "string",
                "null"
              ]
            },
            "server": {
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/ItemStatus"
            },
            "tool": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "mcpToolCall",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "server",
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "call": {
              "additionalProperties": true,
              "type": "object"
            },
            "disposition": {
              "enum": [
                "succeeded",
                "denied",
                "failed",
                "conflict",
                "limit",
                "cancelled",
                "uncertain",
                null
              ]
            },
            "id": {
              "type": "string"
            },
            "output": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/ItemStatus"
            },
            "type": {
              "const": "toolCall",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "call",
            "status"
          ],
          "type": "object"
        }
      ]
