        "invalidRequest",
        "missingSession",
        "noSessionForWorkspace",
        "tooManySessions",
        "sessionBusy",
        "workspaceBusy",
        "goalUnavailable",
        "goalAdmissionUncertain",
        "goalBudgetExhausted",
        "goalNotContinuable",
        "guardUnavailable",
        "sessionNotIdle",
        "forkNotAtRunBoundary",
        "workspaceMismatch",
        "invalidWorkspacePath",
        "inputNotRegular",
        "inputTooLarge",
        "inputNotUtf8",
        "missingInclude",
        "tooManyIncludes",
        "stateOverlap",
        "workspaceUnavailable",
        "invalidHistory",
        "contextTooLarge",
        "imagesNotAdmitted",
        "compactionInputEmpty",
