      "enum": [
        "inProgress",
        "completed",
        "failed",
        "declined",
        "uncertain"
      ],
      "type": "string"
    },
    "Message": {
      "anyOf": [
        {
          "$ref": "#/$defs/Request"
        },
        {
          "$ref": "#/$defs/Notification"
        },
        {
          "$ref": "#/$defs/Response"
        },
        {
          "$ref": "#/$defs/ErrorResponse"
        }
      ]
    },
    "Notification": {
      "additionalProperties": false,
