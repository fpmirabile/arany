    "EventsResyncNotification": {
      "additionalProperties": false,
      "properties": {
        "lastSequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "missed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
