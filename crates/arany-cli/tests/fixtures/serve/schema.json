        "event_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "enum": [
            "SessionStarted",
            "SessionDefaultChanged",
            "SessionForked",
            "ContextCompacted",
            "SessionRenamed",
            "GoalStarted",
            "GoalRunLinked",
            "GoalResumed",
            "GoalPlanContractRecorded",
            "GoalFinished",
            "MessageAccepted",
            "RunStarted",
            "AgentSpawned",
            "ProviderFallbackUsed",
            "ProviderCallRecorded",
            "GoalProviderCallReserved",
            "GoalCompactionCallReserved",
            "GoalContextCompacted",
            "GoalSteeringNoteRecorded",
            "AssistantDisplayRecorded",
            "ToolStarted",
            "ToolFinished",
            "ToolPermissionDecided",
            "AgentFinished",
            "MessageCommitted",
            "RunFinished"
          ],
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "type": "object"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
