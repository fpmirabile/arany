    "ImageMediaType": {
      "enum": [
        "image/png"
      ],
      "type": "string"
    },
    "ImageMetadata": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "index": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "mediaType": {
          "$ref": "#/$defs/ImageMediaType"
        }
